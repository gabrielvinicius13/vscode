{
    "compilerOptions": {
        "module": "ESNext",
        "target": "ES2022",
        "lib": ["ES2022", "DOM"],
        "outDir": "out",
        "sourceMap": true,
        "strict": true,
        "noImplicitOverride": true,
        "moduleResolution": "bundler",
        "noEmit": true,
        "skipLibCheck": true,
        "types": ["node", "vscode"]
    },
    "exclude": ["node_modules", ".vscode-test", "tsup.config.ts"]
}
